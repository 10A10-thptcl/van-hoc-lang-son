<!doctype html>
<html lang="vi">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Bản đồ số Văn học Xứ Lạng</title>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700&family=Lora:ital,wght@0,600;0,700;1,500&display=swap">
<style>
:root{--bg:#f3faf6;--card:#fff;--ink:#1c2b39;--muted:#59697a;--line:#d9e7df;--navy:#1d3a8a;--red:#d6334a;--purple:#6a4bd8;--coral:#e0562f;--tint-red:#fde8eb;--tint-pur:#ece8fb;--tint-cor:#fdebe3;
--land1:#d3ebc9;--land2:#a8d79a;--out:#e8f2e4;--river:#6db6e8;--road:#f0a030;--lab:#2b4a2e;
box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}
:root:not([data-theme="light"]){color-scheme:light dark}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]){--bg:#0f1a16;--card:#17251f;--ink:#e8f1ec;--muted:#9bb0a6;--line:#2a3d34;--navy:#9db7ff;--tint-red:#3a1d24;--tint-pur:#25204a;--tint-cor:#3a2418;--land1:#2e4a33;--land2:#3d6a42;--out:#1d2f25;--river:#3d82b5;--lab:#d4ecd0}}
:root[data-theme="dark"]{--bg:#0f1a16;--card:#17251f;--ink:#e8f1ec;--muted:#9bb0a6;--line:#2a3d34;--navy:#9db7ff;--tint-red:#3a1d24;--tint-pur:#25204a;--tint-cor:#3a2418;--land1:#2e4a33;--land2:#3d6a42;--out:#1d2f25;--river:#3d82b5;--lab:#d4ecd0}
html{scroll-padding-top:env(safe-area-inset-top,0px)}
*{box-sizing:border-box}
body{margin:0;background:var(--bg);color:var(--ink);font:15px/1.55 "Be Vietnam Pro",system-ui,sans-serif}
button,input{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--purple);outline-offset:2px}
header{background:linear-gradient(180deg,#dff1ff,#e6f6e9 70%,var(--bg));padding:28px 20px 20px;text-align:center;position:relative;overflow:hidden}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) header{background:linear-gradient(180deg,#16303f,#173026 70%,var(--bg))}}
header svg{position:absolute;left:0;right:0;bottom:0;width:100%;height:70px;opacity:.5}
header h1{font:700 clamp(26px,4.6vw,46px)/1.15 Lora,Georgia,serif;color:var(--navy);margin:0 0 6px;position:relative}
header p{margin:0;font:italic 500 clamp(15px,2vw,19px) Lora,Georgia,serif;color:var(--muted);position:relative}
main{max-width:1320px;margin:0 auto;padding:16px 16px 40px}
.grid{display:grid;grid-template-columns:270px minmax(0,1fr) 250px;gap:16px;align-items:start}
.panel{background:var(--card);border:1px solid var(--line);border-radius:16px;padding:16px;box-shadow:0 4px 18px rgba(30,70,50,.07)}
.search{display:flex;align-items:center;gap:8px;border:1.5px solid var(--line);border-radius:999px;padding:6px 14px;margin-bottom:14px;background:var(--bg)}
.search input{border:0;background:none;flex:1;min-width:0;outline:0;padding:4px 0}
.search:focus-within{border-color:var(--purple)}
.search button{border:0;background:none;cursor:pointer;color:var(--muted);font-size:18px;line-height:1}
.layer{display:flex;gap:12px;align-items:center;padding:10px;border-radius:12px;margin-bottom:8px;border:1px solid var(--line)}
.layer i{width:36px;height:36px;border-radius:10px;display:grid;place-items:center;color:#fff;font-style:normal;font-size:18px;flex:none}
.layer b{display:block;font-size:14px;line-height:1.3}.layer small{color:var(--muted)}
.layer label{flex:1;display:flex;gap:10px;align-items:center;cursor:pointer}
.layer input{width:18px;height:18px;accent-color:var(--purple);margin-left:auto}
.layer.off{opacity:.6}
h3{font-size:14px;margin:16px 0 8px;color:var(--navy)}
.pl{display:flex;gap:10px;align-items:center;width:100%;text-align:left;border:0;background:none;padding:8px;border-radius:10px;cursor:pointer}
.pl:hover,.pl.on{background:var(--bg)}
.pl[hidden]{display:none}
.dot{width:12px;height:12px;border-radius:50%;flex:none}
.mapwrap{position:relative;border-radius:16px;overflow:hidden;border:1px solid var(--line);background:var(--out);box-shadow:0 4px 18px rgba(30,70,50,.07)}
.mapwrap.sat{--land1:#59734a;--land2:#3e5a34;--out:#2c3f2a;--lab:#f3f7ee;--river:#4f8fb8}
svg.map{display:block;width:100%;height:auto;touch-action:pan-y}
.seg{position:absolute;left:12px;top:12px;display:flex;background:var(--card);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.18)}
.seg button{border:0;background:none;padding:7px 14px;cursor:pointer;font-weight:500;font-size:13px}
.seg button[aria-pressed=true]{background:var(--navy);color:#fff}
@media (prefers-color-scheme:dark){:root:not([data-theme="light"]) .seg button[aria-pressed=true]{color:#0f1a16}}
.zoom{position:absolute;left:12px;bottom:12px;display:flex;flex-direction:column;background:var(--card);border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,.18)}
.zoom button{border:0;background:none;width:36px;height:36px;font-size:20px;cursor:pointer}
.zoom button+button{border-top:1px solid var(--line)}
.hint{position:absolute;left:50%;bottom:12px;transform:translateX(-50%);background:var(--card);padding:5px 14px;border-radius:999px;font-size:13px;color:var(--muted);box-shadow:0 2px 8px rgba(0,0,0,.15);white-space:nowrap}
.pin{cursor:pointer}.pin .ring{fill:none;stroke-width:3;opacity:0}
.pin.on .ring{opacity:.5;animation:pulse 1.6s ease-out infinite;transform-box:fill-box;transform-origin:center}
.pin:focus-visible{outline:none}.pin:focus-visible .body{stroke:#000;stroke-width:3}
.pin[data-hide]{display:none}
@keyframes pulse{from{transform:scale(.6);opacity:.7}to{transform:scale(1.6);opacity:0}}
@media (prefers-reduced-motion:reduce){.pin.on .ring{animation:none;opacity:.5}}
.pop{position:absolute;top:12px;right:12px;width:min(340px,calc(100% - 24px));max-height:calc(100% - 24px);overflow:auto;background:var(--card);border-radius:16px;box-shadow:0 10px 32px rgba(20,40,60,.28);padding:14px}
.pop[hidden]{display:none}
.pop header{all:unset;display:flex;align-items:center;gap:10px;margin-bottom:10px}
.pop header h2{flex:1;margin:0;font-size:17px;font-weight:700}
.pop .x{border:0;background:none;font-size:22px;cursor:pointer;color:var(--muted)}
.scene{border-radius:12px;overflow:hidden;line-height:0;margin-bottom:10px}.scene svg{width:100%;height:auto}
.tabs{display:flex;gap:6px;margin-bottom:10px}
.tabs button{flex:1;border:0;border-radius:8px;padding:7px 4px;font-size:13px;font-weight:600;cursor:pointer;background:var(--bg);color:var(--muted)}
.tabs button[aria-selected=true]{background:var(--c);color:#fff}
.pop h4{margin:0 0 4px;font-size:15px}
.pop p{margin:0 0 8px;font-size:14px}
blockquote{margin:8px 0;padding:8px 12px;border-left:4px solid var(--c);background:var(--bg);border-radius:0 10px 10px 0;font:italic 500 15px/1.5 Lora,Georgia,serif}
.cta{display:inline-flex;gap:8px;align-items:center;border:0;border-radius:999px;padding:9px 18px;color:#fff;background:var(--c);font-weight:600;cursor:pointer}
.media{display:flex;gap:8px;align-items:center;width:100%;border:1px dashed var(--line);background:var(--bg);border-radius:10px;padding:10px;margin-bottom:8px;text-align:left}
.note{font-size:12.5px;color:var(--muted)}
.feat .it{display:flex;gap:10px;padding:8px 0;border-bottom:1px solid var(--line);cursor:pointer;width:100%;background:none;border-left:0;border-right:0;border-top:0;text-align:left}
.feat .n{width:24px;height:24px;border-radius:50%;color:#fff;display:grid;place-items:center;font-size:12px;font-weight:700;flex:none}
.feat small{color:var(--muted);display:block}
.feat q{display:block;margin-top:14px;font:italic 500 16px/1.5 Lora,Georgia,serif;color:var(--navy);quotes:"“" "”"}
.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:16px;margin-top:16px}
.card{background:var(--card);border:1.5px solid var(--c);border-radius:16px;overflow:hidden;cursor:pointer;text-align:left;padding:0;display:block}
.card h2{margin:0;padding:10px 14px;background:var(--c);color:#fff;font-size:15px}
.card .b{padding:12px;display:grid;gap:10px}
.card .lab{background:var(--t);border-radius:10px;padding:8px 10px;font-size:13.5px}
.card .lab b{display:block}.card .lab em{font:italic 500 14px/1.45 Lora,Georgia,serif}
@media (max-width:1060px){.grid{grid-template-columns:1fr}.cards{grid-template-columns:1fr}.side2{order:3}}
@media (max-width:760px){.pop{position:static;width:auto;max-height:none;border-radius:0;box-shadow:none;border-top:1px solid var(--line)}.hint{display:none}}

#lmap{height:clamp(380px,70vh,640px);z-index:0;background:#e8f2e4}
.seg,.pop,.hint{z-index:1000}
.pin{position:absolute;left:0;top:0;cursor:pointer}
.pin .pb{position:absolute;left:-14px;top:-34px;width:28px;height:28px;border-radius:50% 50% 50% 0;transform:rotate(-45deg);border:2.5px solid #fff;box-shadow:0 3px 8px rgba(0,0,0,.35)}
.pin .pb::after{content:"";position:absolute;inset:7px;background:#fff;border-radius:50%}
.pin .pn{position:absolute;left:0;top:-68px;transform:translateX(-50%);white-space:nowrap;color:#fff;padding:3px 11px;border-radius:12px;font:700 12.5px "Be Vietnam Pro",sans-serif;border:2px solid #fff;box-shadow:0 2px 6px rgba(0,0,0,.3)}
.pin.on .pb{box-shadow:0 0 0 6px rgba(106,75,216,.35),0 3px 8px rgba(0,0,0,.35)}
.pin:focus-visible .pb{outline:3px solid #000}
@media (min-width:1061px){.grid>aside.panel:first-child,.grid>aside.side2{position:sticky;top:12px}}
@media (max-width:1060px){.grid>section{order:-1}}
@media (max-width:760px){main{padding:10px 10px 32px}.pin .pn{font-size:11px;padding:2px 8px}.seg button{padding:9px 14px}.panel{padding:12px}}
.tabs button{min-height:40px}.pl{min-height:44px}.cta{min-height:44px}.seg button{min-height:36px}
.card{transition:box-shadow .2s,transform .2s}.card:hover{box-shadow:0 8px 24px rgba(30,70,50,.18);transform:translateY(-2px)}
@media (prefers-reduced-motion:reduce){.card{transition:none}.card:hover{transform:none}}
footer{max-width:1320px;margin:0 auto;padding:0 16px 28px;font-size:12.5px;color:var(--muted);text-align:center}

/* --- mobile polish --- */
@media (max-width:760px){
header{padding:20px 14px 34px}
header h1{font-size:clamp(24px,7.4vw,32px)}header p{font-size:14px}
.grid{gap:12px}
.pop{position:fixed;left:0;right:0;bottom:0;top:auto;width:auto;max-height:60vh;border-radius:22px 22px 0 0;border:0;box-shadow:0 -10px 32px rgba(20,40,60,.28);z-index:2000;padding:10px 16px calc(16px + env(safe-area-inset-bottom,0px))}
.pop::before{content:"";display:block;width:42px;height:4px;border-radius:4px;background:var(--line);margin:0 auto 10px}
.scene{max-height:150px}.scene img,.scene svg{width:100%;height:150px;object-fit:cover}
.cards{display:flex;overflow-x:auto;scroll-snap-type:x mandatory;gap:12px;padding:4px 2px 14px;margin-inline:-10px;padding-inline:10px;scrollbar-width:none}
.cards::-webkit-scrollbar{display:none}
.card{flex:0 0 84%;scroll-snap-align:center}
.card.rv{transform:translateX(24px)}
}
/* --- motion (only when allowed) --- */
.cf{position:fixed;z-index:3000;pointer-events:none;font-size:20px}
.card.rv{opacity:0;transform:translateY(24px);transition:opacity .6s,transform .6s,box-shadow .2s}
.card.rv.in{opacity:1;transform:none}
@media (prefers-reduced-motion:reduce){.card.rv{opacity:1;transform:none}}
@media (prefers-reduced-motion:no-preference){
header h1{animation:rise .8s cubic-bezier(.2,.8,.2,1) both}
header p{animation:rise .8s .15s cubic-bezier(.2,.8,.2,1) both}
header svg{left:-5%;width:110%;animation:sway 16s ease-in-out infinite alternate}
.pin{animation:drop .75s var(--d,0s) cubic-bezier(.3,1.6,.5,1) both}
.pin.on::after{content:"";position:absolute;left:-20px;top:-8px;width:40px;height:14px;border-radius:50%;border:2px solid var(--c);animation:ripple 1.5s ease-out infinite}
.pin.on .pb{animation:hop .9s ease-in-out infinite}
.pop:not([hidden]){animation:slidein .35s cubic-bezier(.2,.8,.2,1)}
#pb>*{animation:fade .35s both}
.pl,.cta,.card,.tabs button,.seg button{transition:transform .15s,background .2s,box-shadow .2s}
.pl:active,.cta:active,.card:active,.tabs button:active{transform:scale(.97)}
.cf{animation:cf .9s ease-out forwards}
.layer{transition:box-shadow .2s,transform .2s}.layer:hover{box-shadow:0 4px 12px rgba(30,70,50,.12);transform:translateX(3px)}
}
@keyframes rise{from{opacity:0;transform:translateY(16px)}}
@keyframes sway{to{transform:translateX(4%)}}
@keyframes drop{from{opacity:0;transform:translateY(-40px)}}
@keyframes ripple{from{transform:scale(.4);opacity:.9}to{transform:scale(1.8);opacity:0}}
@keyframes hop{50%{transform:rotate(-45deg) translate(3px,-3px)}}
@keyframes slidein{from{opacity:0;transform:translateX(24px)}}
@keyframes fade{from{opacity:0;transform:translateY(6px)}}
@keyframes cf{to{transform:translate(var(--x),var(--y)) scale(1.3);opacity:0}}
@media (max-width:760px) and (prefers-reduced-motion:no-preference){@keyframes slidein{from{transform:translateY(100%)}}}
.work{border-left:4px solid var(--c);padding:6px 10px;margin:8px 0;background:var(--bg);border-radius:0 10px 10px 0}.work small{color:var(--muted)}.work p{margin:4px 0 0;font-size:13.5px}.src{font-size:12px;color:var(--muted);margin-top:8px}
.links{list-style:none;padding:0;margin:6px 0}.links li{padding:5px 0}.links a,.lk{color:var(--c);font-weight:600;text-decoration:underline;text-underline-offset:3px;font-size:13.5px}.lk{display:inline-block;margin-top:4px}
</style>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/leaflet/1.9.4/leaflet.js"></script>
</head>
<body>
<header>
  <svg viewBox="0 0 1200 70" preserveAspectRatio="none" aria-hidden="true"><path fill="#7fbf8a" d="M0 70V40l40-24 40 30 50-38 40 36 60-30 50 34 60-40 40 32 70-28 50 36 60-34 50 30 60-36 50 34 60-28 50 30 60-32 50 34 60-30 50 28 40-24 50 30 40-26 40 32 50-34 50 30V70z"/></svg>
  <h1>Bản đồ số Văn học Xứ Lạng</h1>
  <p>“Khám phá văn học – Kết nối quá khứ – Lan tỏa tình yêu quê hương”</p>
</header>

<main>
<div class="grid">
  <aside class="panel">
    <label class="search"><span aria-hidden="true">🔍</span><input id="q" type="search" placeholder="Tìm kiếm địa danh, tác phẩm…" aria-label="Tìm kiếm địa danh hoặc tác phẩm"><button id="qx" type="button" aria-label="Xóa tìm kiếm">×</button></label>
    <div class="layer"><label><i style="background:var(--red)">📖</i><span><b>Lớp 1: Địa danh Văn học</b><small>3 điểm đã có (demo)</small></span><input type="checkbox" id="l1" checked></label></div>
    <div class="layer"><label><i style="background:#c27a00">🖋️</i><span><b>Lớp 2: Tác giả – Tác phẩm</b><small>3 điểm (từ nguồn web)</small></span><input type="checkbox" id="l2" checked></label></div>
    <div class="layer off"><label><i style="background:#2f9e5b">🎶</i><span><b>Lớp 3: Văn học dân gian</b><small>Sắp cập nhật</small></span><input type="checkbox" disabled></label></div>
    <div class="layer off"><label><i style="background:var(--purple)">🧭</i><span><b>Lớp 4: Hành trình Văn học</b><small>Sắp cập nhật</small></span><input type="checkbox" disabled></label></div>
    <h3>Các điểm nổi bật</h3>
    <div id="plist"></div>
    <h3>Tác giả – Tác phẩm</h3>
    <div id="alist"></div>
    <p id="none" class="note" hidden>Không có địa danh nào khớp. Thử từ khóa khác, ví dụ “Tô Thị”.</p>
  </aside>

  <section aria-label="Bản đồ">
    <div class="mapwrap" id="mw">
      <div id="lmap" aria-label="Bản đồ tỉnh Lạng Sơn"></div>
      <div class="seg" role="group" aria-label="Kiểu bản đồ"><button type="button" id="b-map" aria-pressed="true">Bản đồ</button><button type="button" id="b-sat" aria-pressed="false">Vệ tinh</button></div>
            <div class="hint" id="hint">Nhấp vào chấm đỏ để khám phá</div>

      <aside class="pop" id="pop" hidden aria-live="polite">
        <header><span class="dot" id="pd" style="width:30px;height:30px;display:grid;place-items:center;color:#fff">📖</span><h2 id="pt"></h2><button class="x" id="px" type="button" aria-label="Đóng">×</button></header>
        <div class="scene" id="ps"></div>
        <div class="tabs" role="tablist"><button role="tab" id="t0" aria-selected="true">Kiến thức</button><button role="tab" id="t1" aria-selected="false">Nghe – Nhìn</button><button role="tab" id="t2" aria-selected="false">Check-in</button></div>
        <div id="pb"></div>
      </aside>
    </div>
  </section>

  <aside class="panel side2 feat">
    <h3 style="margin-top:0">Khám phá 3 địa điểm tiêu biểu (demo)</h3>
    <div id="feat"></div>
    <q>Văn học Xứ Lạng – hành trình của ký ức và cảm xúc!</q>
  </aside>
</div>

<div class="cards" id="cards"></div>
</main>
<footer>Bản đồ: © OpenStreetMap, © CARTO, Esri. Nội dung văn học mang tính giới thiệu (bản demo).</footer>

<script>if(!window.L){document.getElementById("lmap").innerHTML="<p style='padding:24px'>Không tải được thư viện bản đồ. Hãy kiểm tra kết nối mạng và mở lại trang.</p>"}</script>
<script>
const P=[
{id:"kylua",name:"Phố Kỳ Lừa",c:"#d6334a",t:"var(--tint-red)",lat:21.8570,lng:106.7600,head:"Phố Kỳ Lừa – Kỳ Lừa",sub:"Giao thương, sầm uất",
 desc:"Câu ca dao nổi tiếng nhất về Xứ Lạng:",q:["Đồng Đăng có phố Kỳ Lừa","Có nàng Tô Thị, có chùa Tam Thanh"],mean:"Biểu tượng giao thương, sầm uất của Lạng Sơn xưa.",
 media:["Nghe ca dao","Xem ảnh chợ Kỳ Lừa cũ"]},
{id:"tothi",name:"Núi Tô Thị",c:"#6a4bd8",t:"var(--tint-pur)",lat:21.8650,lng:106.7300,head:"Núi Tô Thị – Biểu tượng người phụ nữ Việt",sub:"Truyền thuyết, tình mẫu tử",
 desc:"Truyền thuyết kể về nàng Tô Thị bồng con chờ chồng hóa đá. Nhiều bài thơ đã viết về nàng, trong đó có bài thơ của Hồ Chí Minh khi thăm Tô Thị:",q:["Tô Thị! Tô Thị!","Ngồi cao mấy trượng…"],mean:"Hình tượng người phụ nữ Việt thủy chung, kiên nhẫn chờ chồng.",
 media:["Nghe truyền thuyết","Xem video"]},
{id:"chilang",name:"Ải Chi Lăng",c:"#e0562f",t:"var(--tint-cor)",lat:21.6800,lng:106.6050,head:"Ải Chi Lăng – Đất thiêng anh hùng",sub:"Chiến thắng lịch sử",
 desc:"Gắn với chiến thắng Chi Lăng (Liễu Thăng), thơ của Tố Hữu, Nguyễn Trãi.",q:["Chi Lăng là ải hiểm…"],mean:"Nơi ghi dấu chiến thắng lịch sử của dân tộc.",
 media:["Thơ về Chi Lăng","Xem video tái hiện lịch sử"]}
];
P.forEach(p=>p.layer=1);
P[0].works=[{a:"Dân gian",y:"",t:"Ca dao “Đồng Đăng có phố Kỳ Lừa…”",n:"Câu ca dao truyền miệng nhắc cùng lúc phố Kỳ Lừa, nàng Tô Thị và chùa Tam Thanh, gần như thành “danh thiếp” của xứ Lạng."}];
P[1].works=[{a:"Phạm Quỳnh",y:"1892–1945",t:"Du ký “Chơi Lạng Sơn Cao Bằng” (Nam Phong)",n:"Ghi nhận Tô Thị là một ngọn núi trong dãy Tam Thanh, còn gọi là núi Vọng Phu; theo ông thuật lại thì tượng đá đã bị sét đánh đổ."},{a:"Hồ Chí Minh",y:"",t:"Bài thơ khi thăm Tô Thị",n:"Theo nội dung mẫu của dự án; cần đối chiếu nguồn để ghi chính xác tên bài và năm sáng tác."}];
P[2].works=[{a:"Tố Hữu, Nguyễn Trãi",y:"",t:"Thơ gắn với chiến thắng Chi Lăng",n:"Theo nội dung mẫu của dự án; cần bổ sung tên bài cụ thể."}];
const A=[
{id:"tamthanh",name:"Động Tam Thanh – Nhị Thanh",c:"#c27a00",t:"var(--tint-cor)",lat:21.8672,lng:106.7268,head:"Ngô Thì Sĩ và thơ khắc ở động Tam Thanh",sub:"Thơ khắc vách đá, danh sĩ đốc trấn",
 desc:"Quần thể Nhị Thanh – Tam Thanh được mệnh danh “Đệ nhất bát cảnh xứ Lạng”. Trong động Tam Thanh còn lưu hệ thống bia và thơ khắc của nhiều văn nhân qua các thời kỳ.",q:[],
 mean:"Văn chương hòa vào danh thắng: thơ được khắc ngay trên vách đá, và lễ hội chùa Tam Thanh (15 tháng Giêng) có nghi thức rước bài vị Ngô Thì Sĩ.",
 works:[{a:"Ngô Thì Sĩ",y:"1726–1780",t:"Thơ khắc ở động Tam Thanh (một nguồn gọi là “Vịnh Tiên Sơn tự”)",n:"Làm đốc trấn Lạng Sơn, ông đi khắp núi non xứ Lạng và để lại thơ ca ngợi cảnh đẹp. Động Nhị Thanh được cho là do ông tìm ra và đặt theo bút hiệu của ông."},{a:"Nhiều văn nhân, thi sĩ",y:"",t:"Văn bia trong động Tam Thanh",n:"Nhiều thế hệ văn nhân để lại bia khắc ca ngợi cảnh sơn thủy hữu tình."}],
 media:["Nghe đọc thơ khắc","Xem ảnh văn bia"],src:"Nguồn tham khảo: Thanh Niên, Giáo dục Việt Nam, Vinpearl."},
{id:"mayen",name:"Núi Mã Yên – Chi Lăng",c:"#c27a00",t:"var(--tint-cor)",lat:21.6760,lng:106.6130,head:"Chi Lăng trong Bình Ngô đại cáo và thơ ca",sub:"Nguyễn Trãi, Nguyễn Duy",
 desc:"Trận Chi Lăng – Mã Yên ngày 10/10/1427 phá tan cánh quân cứu viện do Liễu Thăng chỉ huy. Chiến thắng này được ghi vào Bình Ngô đại cáo (1428) của Nguyễn Trãi:",q:["Ngày mười tám, trận Chi Lăng, Liễu Thăng thất thế","Ngày hai mươi, trận Mã Yên, Liễu Thăng cụt đầu"],
 mean:"Biến chiến công thành áng văn chính luận bất hủ, tuyên cáo nền độc lập của Đại Việt.",
 works:[{a:"Nguyễn Trãi",y:"1380–1442",t:"Bình Ngô đại cáo (1428)",n:"Bài cáo viết thay lời Lê Lợi, tuyên bố chiến thắng quân Minh; đoạn kể chiến công nêu rõ trận Chi Lăng, Mã Yên và các tướng giặc bại trận."},{a:"Nguyễn Duy",y:"",t:"Thơ “Ải Chi Lăng”",n:"Bài thơ gợi lại lưỡi gươm Liễu Thăng nơi ải trấn Nam Môn (theo tuyển thơ về Lạng Sơn đăng trên VOH; nên đối chiếu thêm nguồn xuất bản)."}],
 media:["Nghe đọc Bình Ngô đại cáo","Xem video trận Chi Lăng"],src:"Nguồn tham khảo: Báo Văn hóa, Hoatieu, VietJack, VOH."},
{id:"vhnt",name:"Hội Văn học Nghệ thuật Lạng Sơn",c:"#c27a00",t:"var(--tint-cor)",lat:21.8537,lng:106.7580,head:"Văn học đương đại xứ Lạng",sub:"Văn nghệ sĩ địa phương",
 desc:"Hội Văn học Nghệ thuật tỉnh là nơi tập hợp văn nghệ sĩ xứ Lạng. Tỉnh xét tặng Giải thưởng Văn học nghệ thuật định kỳ 5 năm một lần, tính từ năm 2025. Vị trí trên bản đồ chỉ mang tính minh họa.",q:[],
 mean:"Cầu nối giữa văn học truyền thống và sáng tác mới của người xứ Lạng.",
 works:[{a:"Nguyễn Phúc Hà",y:"sinh 1969",t:"Chủ tịch Hội Văn học Nghệ thuật tỉnh",n:"Người dân tộc Tày, quê xã Vũ Lăng; từng làm ở Trung tâm Văn hóa tỉnh và Đoàn nghệ thuật ca múa kịch."},{a:"Nhiều tác giả địa phương",y:"",t:"Giải thưởng Văn học nghệ thuật tỉnh Lạng Sơn",n:"Giải xét tặng cho tác giả, nhóm tác giả có tác phẩm xuất sắc."}],
 media:["Nghe giới thiệu tác giả","Xem triển lãm sách"],src:"Nguồn tham khảo: Tiền Phong, văn bản của HĐND tỉnh Lạng Sơn."}
];
A.forEach(p=>p.layer=2);
const ALL=[...P,...A];
const LK={
kylua:[{t:"Chợ Kỳ Lừa – nét độc đáo phiên chợ vùng cao (Vinpearl)",u:"https://vinpearl.com/vi/cho-ky-lua-lang-son-kham-pha-net-doc-dao-phien-cho-vung-cao"},{t:"“Đồng Đăng có phố Kỳ Lừa” (Thanh Niên)",u:"https://thanhnien.vn/du-son-ngoan-thuy-dong-dang-co-pho-ky-lua-18526050321493282.htm"}],
tothi:[{t:"Du sơn ngoạn thủy: nàng Tô Thị và Tam Thanh (Thanh Niên)",u:"https://thanhnien.vn/du-son-ngoan-thuy-dong-dang-co-pho-ky-lua-18526050321493282.htm"},{t:"Cẩm nang du lịch Lạng Sơn (VnExpress)",u:"https://vnexpress.net/cam-nang-du-lich-lang-son-4660039.html"},{t:"Thơ, ca dao, tục ngữ về Lạng Sơn (VOH)",u:"https://voh.com.vn/song-dep/tho-ca-dao-tuc-ngu-ve-lang-son-493973.html"}],
chilang:[{t:"Lịch sử và vẻ đẹp của Ải Chi Lăng (Vinpearl)",u:"https://vinpearl.com/vi/kham-pha-lich-su-va-ve-dep-cua-ai-chi-lang-lang-son"},{t:"Kỷ niệm 598 năm chiến thắng Chi Lăng (Báo Văn hóa)",u:"https://baovanhoa.vn/van-hoa/ky-niem-598-nam-chien-thang-chi-lang-173791.html"}],
tamthanh:[{t:"Chùa Tam Thanh – Đệ nhất bát cảnh xứ Lạng (Vinpearl)",u:"https://vinpearl.com/vi/chua-tam-thanh-lang-son-de-nhat-bat-canh-xu-lang-co-gi"},{t:"Ngoạn cảnh chùa Tam Thanh (Giáo dục Việt Nam)",u:"https://giaoduc.net.vn/dep-me-hon-khi-ngoan-canh-chua-tam-thanh-xu-lang-post66258.gd"},{t:"Ngô Thì Sĩ (Wikipedia)",u:"https://en.wikipedia.org/wiki/Ng%C3%B4_Th%C3%AC_S%C4%A9"}],
mayen:[{t:"Bình Ngô đại cáo (Wikipedia)",u:"https://en.wikipedia.org/wiki/B%C3%ACnh_Ng%C3%B4_%C4%91%E1%BA%A1i_c%C3%A1o"},{t:"Soạn bài Bình Ngô đại cáo (VietJack)",u:"https://vietjack.com/soan-van-10-kn/binh-ngo-dai-cao.jsp"},{t:"Diễn biến chiến thắng Chi Lăng 1427 (Hoatieu)",u:"https://hoatieu.vn/bieu-mau/de-cuong-tuyen-truyen-ky-niem-590-nam-chien-thang-chi-lang-huyen-chi-lang-131309"}],
vhnt:[{t:"Ông Nguyễn Phúc Hà làm Chủ tịch Hội VHNT Lạng Sơn (Tiền Phong)",u:"https://tienphong.vn/ong-nguyen-phuc-ha-lam-chu-tich-hoi-van-hoc-nghe-thuat-tinh-lang-son-post1871043.tpo"},{t:"Nghị quyết về Giải thưởng VHNT tỉnh Lạng Sơn (vbpl.vn)",u:"https://vbpl.vn/FileData/TW/Lists/vbpq/Attachments/168966/VanBanGoc_NQ%2012.2024.NQ.HDND.pdf"}]};
ALL.forEach(p=>p.links=LK[p.id]||[]);
P[0].works[0].u=LK.kylua[1].u;P[1].works[0].u=LK.tothi[0].u;
A[0].works[0].u=LK.tamthanh[2].u;A[1].works[0].u=LK.mayen[0].u;A[1].works[1].u=LK.tothi[2].u;A[2].works[0].u=LK.vhnt[0].u;A[2].works[1].u=LK.vhnt[1].u;
const $=s=>document.querySelector(s);
const scene=c=>`<svg viewBox="0 0 160 90" aria-hidden="true"><defs><linearGradient id="s${c.slice(1)}" x1="0" y1="0" x2="0" y2="1"><stop offset="0" stop-color="#cfe9ff"/><stop offset="1" stop-color="#f6efe0"/></linearGradient></defs><rect width="160" height="90" fill="url(#s${c.slice(1)})"/><circle cx="128" cy="22" r="11" fill="#ffd36b"/><path d="M0 70l28-40 22 26 26-34 30 44 24-22 30 26v20H0z" fill="${c}" opacity=".55"/><path d="M0 80l36-22 30 16 34-20 30 18 30-12v30H0z" fill="${c}"/></svg>`;
const pic=p=>`<img src="images/${p.id}.jpg" alt="${p.name}" loading="lazy" style="display:block;width:100%;aspect-ratio:16/9;object-fit:cover" onerror="this.outerHTML=scene('${p.c}')">`;
let sel=null,tab=0,z=1,q="",checked=new Set(),on={1:true,2:true};
$("#alist").innerHTML=A.map(p=>`<button class="pl" data-id="${p.id}"><span class="dot" style="background:${p.c}"></span><span><b>${p.name}</b><small style="display:block;color:var(--muted)">${p.sub}</small></span></button>`).join("");
$("#plist").innerHTML=P.map(p=>`<button class="pl" data-id="${p.id}"><span class="dot" style="background:${p.c}"></span>${p.name}</button>`).join("");
$("#feat").innerHTML=P.map((p,i)=>`<button class="it" data-id="${p.id}"><span class="n" style="background:${p.c}">${i+1}</span><span><b>${p.name}</b><small>${p.sub}</small></span></button>`).join("");
$("#cards").innerHTML=P.map((p,i)=>`<button class="card" data-id="${p.id}" style="--c:${p.c};--t:${p.t}"><h2>${i+1}. ${p.head.toUpperCase?p.head:p.head}</h2><div class="b"><div class="scene">${pic(p)}</div><div class="lab"><b>Văn học:</b>${p.desc}</div><div class="lab"><em>${p.q.map(l=>"“"+l.replace(/[“”]/g,"")+"”").join("<br>")}</em></div><div class="lab"><b>Ý nghĩa:</b>${p.mean}</div></div></button>`).join("");

const map=L.map("lmap",{scrollWheelZoom:false}).setView([21.80,106.66],10);
map.on("click focus",()=>map.scrollWheelZoom.enable());map.on("mouseout",()=>map.scrollWheelZoom.disable());
window.addEventListener("resize",()=>map.invalidateSize());
const carto=L.tileLayer("https://{s}.basemaps.cartocdn.com/rastertiles/voyager/{z}/{x}/{y}{r}.png",{maxZoom:19,subdomains:"abcd",attribution:"© OpenStreetMap, © CARTO"});
const osmStd=L.tileLayer("https://tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap"});
let osm=L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Street_Map/MapServer/tile/{z}/{y}/{x}",{maxZoom:18,attribution:"Tiles © Esri"}).addTo(map);
const fb=[carto,osmStd];
const sat=L.tileLayer("https://server.arcgisonline.com/ArcGIS/rest/services/World_Imagery/MapServer/tile/{z}/{y}/{x}",{maxZoom:18,attribution:"Tiles © Esri"});
let warned=false;
function bad(){if(map.hasLayer(osm)&&fb.length){map.removeLayer(osm);osm=fb.shift();osm.addTo(map);osm.on("tileerror",bad);return}
if(warned)return;warned=true;$("#hint").hidden=false;$("#hint").textContent="Không tải được bản đồ: kiểm tra mạng hoặc mở trang bằng trình duyệt trên máy."}
osm.on("tileerror",bad);sat.on("tileerror",bad);
const mk={};
ALL.forEach((p,i)=>{mk[p.id]=L.marker([p.lat,p.lng],{keyboard:false,icon:L.divIcon({className:"",iconSize:[0,0],html:`<div class="pin" style="--c:${p.c};--d:${i*.15}s" data-id="${p.id}" role="button" tabindex="0" aria-label="${p.name}"><div class="pb" style="background:${p.c}"></div><div class="pn" style="background:${p.c}">${p.name}</div></div>`})}).addTo(map)});
let last=null;
function view(){if(sel&&sel!==last){const p=ALL.find(a=>a.id===sel);map.flyTo([p.lat,p.lng],Math.max(map.getZoom(),12),{duration:.8});if(innerWidth<=760)map.once("moveend",()=>map.panBy([0,110]))}last=sel}
function filt(){const k=q.trim().toLowerCase();let n=0;
ALL.forEach(p=>{const hit=on[p.layer]&&(!k||(p.name+" "+p.head+" "+p.desc+" "+p.q.join(" ")+" "+(p.works||[]).map(w=>w.a+" "+w.t).join(" ")).toLowerCase().includes(k));
hit?mk[p.id].addTo(map):mk[p.id].remove();
document.querySelectorAll('.pl[data-id="'+p.id+'"]').forEach(e=>e.hidden=!hit);if(hit)n++});
$("#none").hidden=n>0;render()}
function burst(){const b=$("#ck");if(!b||matchMedia("(prefers-reduced-motion:reduce)").matches)return;const r=b.getBoundingClientRect();["✨","🎉","📖","⭐","🌟","🎊"].forEach(e=>{for(let k=0;k<2;k++){const t=document.createElement("span");t.className="cf";t.textContent=e;const a=Math.random()*6.28,m=50+Math.random()*60;t.style.cssText="left:"+(r.left+r.width/2)+"px;top:"+r.top+"px;--x:"+Math.cos(a)*m+"px;--y:"+(Math.sin(a)*m-40)+"px";document.body.appendChild(t);setTimeout(()=>t.remove(),900)}})}
function render(){
  const p=ALL.find(a=>a.id===sel);
  document.querySelectorAll(".pin").forEach(e=>e.classList.toggle("on",e.dataset.id===sel));
  document.querySelectorAll(".pl").forEach(e=>e.classList.toggle("on",e.dataset.id===sel));
  $("#pop").hidden=!p;$("#hint").hidden=!!p;
  if(!p)return;
  const pop=$("#pop");pop.style.setProperty("--c",p.c);
  $("#pd").style.background=p.c;$("#pt").textContent=p.name;$("#ps").innerHTML=pic(p);
  [0,1,2].forEach(i=>$("#t"+i).setAttribute("aria-selected",i===tab));
  const b=$("#pb");
  if(tab===0)b.innerHTML=`<h4>${p.head}</h4><p>${p.desc}</p>${p.q.length?`<blockquote>${p.q.map(l=>"“"+l+"”").join("<br>")}</blockquote>`:""}${p.works?`<h4 style="margin-top:10px">Tác giả – Tác phẩm</h4>`+p.works.map(w=>`<div class="work"><b>${w.a}</b> <small>${w.y}</small><br><i>${w.t}</i><p>${w.n}</p>${w.u?`<a class="lk" href="${w.u}" target="_blank" rel="noopener noreferrer">Đọc thêm</a>`:""}</div>`).join(""):""}<p><b>Ý nghĩa:</b> ${p.mean}</p>${p.links.length?`<h4 style="margin-top:10px">Tìm hiểu thêm</h4><ul class="links">${p.links.map(l=>`<li><a href="${l.u}" target="_blank" rel="noopener noreferrer">${l.t}</a></li>`).join("")}</ul>`:""}${p.src?`<p class="src">${p.src}</p>`:""}`;
  if(tab===1)b.innerHTML=p.media.map(m=>`<div class="media"><span aria-hidden="true">▶</span><span>${m}</span></div>`).join("")+`<p class="note">Nội dung âm thanh, video đang được cập nhật.</p>`;
  if(tab===2){const d=checked.has(p.id);b.innerHTML=`<p>Đã đến ${p.name}? Đánh dấu để ghi nhớ hành trình văn học của bạn.</p><button class="cta" id="ck">${d?"✓ Đã check-in":"📷 Check-in tại đây"}</button><p class="note" style="margin-top:8px">Đã check-in: ${checked.size}/${ALL.length} địa danh</p>`;$("#ck").onclick=()=>{d?checked.delete(p.id):checked.add(p.id);render();if(!d)burst()}}
  view();
}
function pick(id){sel=id;tab=0;render();$("#mw").scrollIntoView({block:"nearest",behavior:matchMedia("(prefers-reduced-motion:reduce)").matches?"auto":"smooth"})}
document.addEventListener("click",e=>{const t=e.target.closest("[data-id]");if(t)pick(t.dataset.id)});
document.addEventListener("keydown",e=>{if((e.key==="Enter"||e.key===" ")&&e.target.classList.contains("pin")){e.preventDefault();pick(e.target.dataset.id)}if(e.key==="Escape"&&sel){sel=null;render()}});
[0,1,2].forEach(i=>$("#t"+i).onclick=()=>{tab=i;render()});
$("#px").onclick=()=>{sel=null;render();view()};
$("#q").oninput=e=>{q=e.target.value;filt()};
$("#qx").onclick=()=>{$("#q").value="";q="";filt()};
$("#l2").onchange=e=>{on[2]=e.target.checked;filt()};
$("#l1").onchange=e=>{on[1]=e.target.checked;filt()};
const sw=m=>{m?(map.removeLayer(osm),sat.addTo(map)):(map.removeLayer(sat),osm.addTo(map));$("#b-sat").setAttribute("aria-pressed",m);$("#b-map").setAttribute("aria-pressed",!m)};
$("#b-map").onclick=()=>sw(false);$("#b-sat").onclick=()=>sw(true);
if("IntersectionObserver" in window&&!matchMedia("(prefers-reduced-motion:reduce)").matches){const io=new IntersectionObserver(es=>es.forEach(e=>{if(e.isIntersecting){e.target.classList.add("in");io.unobserve(e.target);setTimeout(()=>e.target.style.transitionDelay="",1200)}}),{threshold:.15});document.querySelectorAll(".card").forEach((c,i)=>{c.classList.add("rv");c.style.transitionDelay=i*.1+"s";io.observe(c)})}
sel=innerWidth<=760?null:"tothi";render();filt();
</script>
</body>
</html>
